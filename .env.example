# Local defaults do not query business records. Use backend/openai for NL reporting.
CHAT_MODE=demo
# Enable only after the web AI usage schema/routes are installed; restart all workers.
# Records provider tokens per company/employee and enforces shared monthly limits.
AI_TOKEN_METERING_ENABLED=false
# Optional: classify unmatched help questions into authorized, reviewed guide IDs.
# Requires OpenAI mode and token metering; no model-authored help answers.
AI_HELP_LLM_FALLBACK_ENABLED=false
# Deterministic, permission-checked buttons after supported help/report answers.
AI_HELP_FOLLOWUPS_ENABLED=false
DATA_MODE=sample
# Set CHAT_MODE=openai and both values below to test real model responses.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional for reasoning models only; omit to use the model's default.
# GPT-6 Luna supports none to preserve non-reasoning output budgets.
# OPENAI_REASONING_EFFORT=none
DATABASE_PATH=data/chat.sqlite3
# Private rotating diagnostics. Give each process its own file when running multiple workers.
APPLICATION_LOG_PATH=logs/application.log
# For real data, set DATA_MODE=backend. BACKEND_URL is the CodeIgniter root,
# without /apiv2. Both servers must use the same randomly generated secret.
BACKEND_URL=http://127.0.0.1/effortrak/effortrak_web
AI_SERVICE_SECRET=

# Separate AI metadata database, not the application's business database.
# Empty uses local SQLite. Multiple hosts require shared PostgreSQL with TLS.
# Example: postgresql+psycopg://ai_user:password@host/effortrak_ai?sslmode=require
CONVERSATION_DATABASE_URL=
CONVERSATION_RETENTION_DAYS=30
REPORT_TTL_SECONDS=86400
MAX_CONCURRENT_CHATS=8
MAX_COMPANY_CONCURRENT_CHATS=4
MAX_EXPORT_WORKERS=2
BACKGROUND_EXPORT_ROWS=200
# Set false on API instances if using separate python -m app.query.worker processes.
RUN_EXPORT_WORKERS=true
