# Local prototype only. All attendance records and identities are fictional.
CHAT_MODE=demo
# Sends full questions to OpenAI for interpretation; backend records remain local.
# Requires CHAT_MODE=openai, backend mode and consent to this data transfer.
SEMANTIC_QUESTIONS=false
DATA_MODE=sample
# Set CHAT_MODE=openai and both values below to test real model responses.
OPENAI_API_KEY=
OPENAI_MODEL=
DATABASE_PATH=data/chat.sqlite3
# For real data, set DATA_MODE=backend. BACKEND_URL is the CodeIgniter root,
# without /apiv2. Both servers must use the same randomly generated secret.
BACKEND_URL=http://127.0.0.1/effortrak/effortrak_web
AI_SERVICE_SECRET=
